{
  "name": "verza-tv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "mux:signed:audit": "node --env-file=.env.local scripts/migrate-mux-signed-playback.mjs",
    "mux:signed:self-test": "node scripts/migrate-mux-signed-playback.mjs --self-test",
    "mux:public:audit": "node scripts/generate-public-mux-map.mjs",
    "mux:public:generate": "node scripts/generate-public-mux-map.mjs --write",
    "test:mux-webhook-security": "node scripts/test-mux-webhook-security.mjs",
    "test:playback-security": "node scripts/test-playback-security.mjs",
    "test:feed-integrity": "node scripts/test-feed-integrity.mjs",
    "test:seo": "node scripts/test-seo-contract.mjs",
    "test:payments": "node scripts/test-payment-integrity.mjs",
    "test:payments:db": "node --env-file=.env.local scripts/test-payment-integrity.mjs --database",
    "test:payments:stripe": "node --env-file=.env.local scripts/test-payment-integrity.mjs --stripe-config",
    "test:payments:stripe-cutover": "VIP_TRANSACTIONAL_NOTICES_ENABLED=false VIP_ANNUAL_RENEWAL_NOTICES_ENABLED=false VIP_YEARLY_CHECKOUT_ENABLED=false node --env-file=.env.local scripts/test-payment-integrity.mjs --stripe-cutover",
    "test:payments:runtime": "npm run test:payments:runtime:compatibility",
    "test:payments:runtime:compatibility": "node scripts/verify-payment-runtime.mjs --require-auth --expect-series-checkout=compatibility",
    "test:payments:runtime:required-consent": "node scripts/verify-payment-runtime.mjs --require-auth --expect-series-checkout=required",
    "test:payments:runtime:public": "node scripts/verify-payment-runtime.mjs",
    "stripe:portal:check": "node --env-file=.env.local scripts/configure-stripe-billing-portal.mjs",
    "stripe:portal:configure": "node --env-file=.env.local scripts/configure-stripe-billing-portal.mjs --apply --confirm-live",
    "audit": "npx tsx scripts/audit-content.ts",
    "audit:perf": "npx tsx scripts/audit-perf.ts",
    "audit:all": "npm run audit && npm run audit:perf"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@mux/mux-node": "^14.1.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "hls.js": "^1.6.16",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.14.0",
    "stripe": "^22.2.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
