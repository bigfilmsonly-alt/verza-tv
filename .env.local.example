# Verza TV — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# Site
NEXT_PUBLIC_SITE_URL=https://verzatv.com

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Mux (video playback)
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
MUX_SIGNING_KEY_ID=your-signing-key-id
MUX_SIGNING_KEY_SECRET=your-signing-key-secret
# Exact boolean. Keep false through compatibility deployment and TestFlight;
# set true only after the generated signed map and signing keys are deployed.
# When true, missing signed configuration fails paid playback closed (HTTP 503).
MUX_SIGNED_PLAYBACK_ENABLED=false

# Stripe (payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Safe default. Set true only after Stripe Tax head-office/registrations and
# test-mode checkout have been reviewed; prices remain tax-exclusive.
STRIPE_AUTOMATIC_TAX_ENABLED=false
# Required for live Stripe keys. False is the compatibility deployment (Series
# Checkout stays available without Stripe's hosted Terms checkbox); set true
# only after Public details has https://www.verzatv.com/terms. Missing, empty,
# or malformed values fail closed in live mode.
STRIPE_CHECKOUT_TOS_CONSENT_REQUIRED=false
# Create and verify the canonical restricted configuration before deployment.
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=bpc_...

# Apple StoreKit series unlocks (server only). Keep disabled until migration
# 015 is applied, all immutable non-consumables are complete/Ready to Submit
# and attached to the app-version review, the Paid Applications Agreement is
# active, and V2 server notifications are set. First-IAP sandbox/App Review
# testing must work before those products can become approved.
APPLE_IAP_ENABLED=false
# Comma-separated VERZA user UUIDs allowed to turn Apple Sandbox/TestFlight
# transactions into entitlements. Never place reviewer or customer identifiers
# in source control; configure the real allowlist in the secret environment.
APPLE_IAP_SANDBOX_ALLOWED_USER_IDS=

# VIP notices and annual-renewal gate. Keep all false until migration 014,
# Resend, the secured Vercel cron, and test-mode notice evidence are verified.
VIP_TRANSACTIONAL_NOTICES_ENABLED=false
VIP_ANNUAL_RENEWAL_NOTICES_ENABLED=false
VIP_YEARLY_CHECKOUT_ENABLED=false

# Transactional email (server only)
RESEND_API_KEY=re_...

# Anthropic (AI Host)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@verzatv.com
PUSH_API_KEY=your-internal-push-api-key

# Vercel
VERCEL_ENV=
# Random 16+ character server secret. Vercel sends it as the cron Bearer token.
CRON_SECRET=replace-with-a-random-secret
